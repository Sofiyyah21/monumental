generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum ProductCategory {
  DRINKS
  NOODLES
  VEGETABLE_OIL
  SUGAR
}

enum ProductUnit {
  PACK
  LITER
  CUP
}

enum StockMovementType {
  RECEIVED
  SOLD
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  PAID
  PENDING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FULFILLED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  FAILED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         UserRole       @default(STAFF)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens RefreshToken[]
  sales          Sale[]        @relation("SellerSales")
  customerSales  Sale[]        @relation("CustomerSales")
  voidedSales    Sale[]        @relation("VoidedSales")
  stockMovements StockMovement[]
  orders         Order[]
  confirmedOrders Order[]       @relation("ConfirmedOrders")
  fulfilledOrders Order[]       @relation("FulfilledOrders")
  cancelledOrders Order[]       @relation("CancelledOrders")
  paidOrders      Order[]       @relation("PaidOrders")

  @@index([role, active])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id                String          @id @default(cuid())
  name              String
  sku               String          @unique
  category          ProductCategory
  unit              ProductUnit
  costPrice         Decimal         @db.Decimal(12, 2)
  sellingPrice      Decimal         @db.Decimal(12, 2)
  currentStock      Decimal         @default(0) @db.Decimal(12, 3)
  reorderLevel      Decimal         @default(0) @db.Decimal(12, 3)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  saleItems      SaleItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([category, active])
  @@index([unit, active])
  @@index([name])
  @@index([currentStock])
}

model Order {
  id            String             @id @default(cuid())
  reference     String             @unique
  customerId    String
  status        OrderStatus        @default(PENDING)
  paymentStatus OrderPaymentStatus @default(UNPAID)
  subtotal      Decimal            @db.Decimal(12, 2)
  confirmedAt   DateTime?
  confirmedById String?
  paidAt        DateTime?
  paidById      String?
  fulfilledAt   DateTime?
  fulfilledById String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  customer    User  @relation(fields: [customerId], references: [id])
  confirmedBy User? @relation("ConfirmedOrders", fields: [confirmedById], references: [id])
  paidBy      User? @relation("PaidOrders", fields: [paidById], references: [id])
  fulfilledBy User? @relation("FulfilledOrders", fields: [fulfilledById], references: [id])
  cancelledBy User? @relation("CancelledOrders", fields: [cancelledById], references: [id])
  items       OrderItem[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([confirmedById, confirmedAt])
  @@index([paidById, paidAt])
  @@index([fulfilledById, fulfilledAt])
  @@index([cancelledById, cancelledAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  productSku      String
  productCategory ProductCategory
  productUnit     ProductUnit
  quantity        Decimal         @db.Decimal(12, 3)
  unitPrice       Decimal         @db.Decimal(12, 2)
  lineSubtotal    Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Sale {
  id               String        @id @default(cuid())
  reference        String        @unique
  sellerId         String
  customerId       String?
  status           SaleStatus    @default(COMPLETED)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PAID)
  paymentReference String?
  subtotal         Decimal       @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  totalCost        Decimal       @db.Decimal(12, 2)
  grossProfit      Decimal       @db.Decimal(12, 2)
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  soldAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  seller User  @relation("SellerSales", fields: [sellerId], references: [id])
  customer User? @relation("CustomerSales", fields: [customerId], references: [id])
  voidedBy User? @relation("VoidedSales", fields: [voidedById], references: [id])
  items   SaleItem[]
  stockMovements StockMovement[]

  @@index([soldAt])
  @@index([sellerId, soldAt])
  @@index([customerId])
  @@index([status, soldAt])
  @@index([paymentStatus, soldAt])
  @@index([voidedById, voidedAt])
}

model SaleItem {
  id           String      @id @default(cuid())
  saleId       String
  productId    String
  productName  String
  productUnit  ProductUnit
  quantity     Decimal     @db.Decimal(12, 3)
  unitPrice    Decimal     @db.Decimal(12, 2)
  unitCost     Decimal     @db.Decimal(12, 2)
  lineTotal    Decimal     @db.Decimal(12, 2)
  lineCost     Decimal     @db.Decimal(12, 2)
  grossProfit  Decimal     @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([saleId])
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  previousStock Decimal           @db.Decimal(12, 3)
  newStock      Decimal           @db.Decimal(12, 3)
  unitCost      Decimal?          @db.Decimal(12, 2)
  reference     String?
  note          String?
  saleId        String?
  createdById   String?
  occurredAt    DateTime          @default(now())

  product   Product @relation(fields: [productId], references: [id])
  sale      Sale?   @relation(fields: [saleId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([productId, occurredAt])
  @@index([type, occurredAt])
  @@index([saleId])
  @@index([createdById, occurredAt])
}

model ShopSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
