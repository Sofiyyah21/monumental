generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum ProductCategory {
  DRINKS
  NOODLES
  VEGETABLE_OIL
  SUGAR
}

enum ProductUnit {
  PACK
  LITER
  CUP
}

enum StockMovementType {
  RECEIVED
  SOLD
  ADJUSTMENT
  RETURN
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         UserRole       @default(STAFF)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens RefreshToken[]
  sales          Sale[]        @relation("SellerSales")
  customerSales  Sale[]        @relation("CustomerSales")
  stockMovements StockMovement[]

  @@index([role, active])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id                String          @id @default(cuid())
  name              String
  sku               String          @unique
  category          ProductCategory
  unit              ProductUnit
  costPrice         Decimal         @db.Decimal(12, 2)
  sellingPrice      Decimal         @db.Decimal(12, 2)
  currentStock      Decimal         @default(0) @db.Decimal(12, 3)
  reorderLevel      Decimal         @default(0) @db.Decimal(12, 3)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([category, active])
  @@index([unit, active])
  @@index([name])
  @@index([currentStock])
}

model Sale {
  id               String        @id @default(cuid())
  sellerId         String
  customerId       String?
  status           SaleStatus    @default(COMPLETED)
  paymentMethod    PaymentMethod
  paymentReference String?
  totalAmount      Decimal       @db.Decimal(12, 2)
  totalCost        Decimal       @db.Decimal(12, 2)
  grossProfit      Decimal       @db.Decimal(12, 2)
  soldAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  seller User  @relation("SellerSales", fields: [sellerId], references: [id])
  customer User? @relation("CustomerSales", fields: [customerId], references: [id])
  items   SaleItem[]
  stockMovements StockMovement[]

  @@index([soldAt])
  @@index([sellerId, soldAt])
  @@index([customerId])
  @@index([status, soldAt])
}

model SaleItem {
  id           String      @id @default(cuid())
  saleId       String
  productId    String
  productName  String
  productUnit  ProductUnit
  quantity     Decimal     @db.Decimal(12, 3)
  unitPrice    Decimal     @db.Decimal(12, 2)
  unitCost     Decimal     @db.Decimal(12, 2)
  lineTotal    Decimal     @db.Decimal(12, 2)
  lineCost     Decimal     @db.Decimal(12, 2)
  grossProfit  Decimal     @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([saleId])
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  previousStock Decimal           @db.Decimal(12, 3)
  newStock      Decimal           @db.Decimal(12, 3)
  unitCost      Decimal?          @db.Decimal(12, 2)
  note          String?
  saleId        String?
  createdById   String?
  occurredAt    DateTime          @default(now())

  product   Product @relation(fields: [productId], references: [id])
  sale      Sale?   @relation(fields: [saleId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([productId, occurredAt])
  @@index([type, occurredAt])
  @@index([saleId])
}

model ShopSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
