NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/monumental_db
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/monumental_test
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=md_refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
# Set to your parent domain only when the frontend and backend share it, for example .example.com.
# Leave unset for localhost or separate hosting domains.
REFRESH_TOKEN_COOKIE_DOMAIN=
# Leave unset to default to true in production and false in development.
# Use true when REFRESH_TOKEN_COOKIE_SAME_SITE=none.
REFRESH_TOKEN_COOKIE_SECURE=
# Use lax when frontend and backend are same-site. Use none only for cross-site HTTPS deployments.
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
ORDER_RATE_LIMIT_WINDOW_MS=60000
ORDER_RATE_LIMIT_MAX=60
SHUTDOWN_GRACE_MS=10000
# API docs are enabled by default outside production. Set true only if production docs should be public.
ENABLE_API_DOCS=
BCRYPT_SALT_ROUNDS=12
BUSINESS_TIMEZONE=Africa/Lagos
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Monumental Admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password
