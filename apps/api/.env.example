NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/monumental_db
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/monumental_test
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_SALT_ROUNDS=12
BUSINESS_TIMEZONE=Africa/Lagos
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Monumental Admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password
